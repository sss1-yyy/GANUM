# 이 파일을 복사해서 backend/.env 를 만들고 값을 채우세요. (.env 는 Git 에 올라가지 않습니다)
# PowerShell: Copy-Item .env.example .env
# 값이 비어 있으면 해당 기능은 시드(예시) 데이터로 동작합니다.

# 공공데이터포털 > "금융위원회_주식시세정보" + "금융위원회_증권상품시세정보" 활용신청 후 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=

# Google AI Studio (https://aistudio.google.com/apikey) 에서 발급한 Gemini API 키
GEMINI_API_KEY=
